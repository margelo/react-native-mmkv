{
  "name": "mmkv-example",
  "version": "4.3.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint \"*.{js,ts,tsx}\" \"{__tests__,src}/**/*.{js,ts,tsx}\" --fix && prettier --write \"*.{js,ts,tsx}\" \"{__tests__,src}/**/*.{js,ts,tsx}\"",
    "lint-ci": "eslint \"*.{js,ts,tsx}\" \"{__tests__,src}/**/*.{js,ts,tsx}\" --max-warnings=0 -f @jamesacarr/github-actions && prettier --check \"*.{js,ts,tsx}\" \"{__tests__,src}/**/*.{js,ts,tsx}\"",
    "start": "react-native start",
    "test": "jest",
    "test:harness": "react-native-harness",
    "web:proxy": "node ./scripts/web-proxy.mjs",
    "web:dev": "node ./scripts/web-dev.mjs",
    "build:android-release": "cd android && ./gradlew assembleRelease --no-daemon",
    "spm": "react-native spm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "http-proxy": "^1.18.1",
    "react-dom": "19.3.0",
    "react-native-mmkv": "*",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.138.g43e09c161101",
    "react-native-web": "~0.21.0",
    "nitro-core": "1.0.0-alpha.nightly.138.g43e09c161101"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-harness/jest": "1.7.0",
    "@react-native-harness/platform-android": "1.7.0",
    "@react-native-harness/platform-apple": "1.7.0",
    "@react-native-harness/platform-web": "1.7.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.15",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "3.8.3",
    "react-native-harness": "1.7.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
