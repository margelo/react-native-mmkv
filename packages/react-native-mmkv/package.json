{
  "name": "react-native-mmkv",
  "version": "4.3.2",
  "description": "⚡️ The fastest key/value storage for React Native.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "lib/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "apple/**/*.h",
    "apple/**/*.m",
    "apple/**/*.mm",
    "apple/**/*.cpp",
    "apple/**/*.swift",
    "cpp/**/*.h",
    "cpp/**/*.hpp",
    "cpp/**/*.cpp",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "Package.swift"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix && prettier --write \"**/*.{js,ts,tsx}\"",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" --max-warnings=0 -f @jamesacarr/github-actions && prettier --check \"**/*.{js,ts,tsx}\"",
    "typescript": "tsc",
    "specs": "nitrogen --logLevel=\"debug\" && tsc",
    "build": "tsc --noEmit false",
    "release": "release-it",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/react-native-mmkv.git"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/react-native-mmkv/issues"
  },
  "homepage": "https://github.com/margelo/react-native-mmkv#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "19.2.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "nitrogen": "1.0.0-alpha.nightly.138.g43e09c161101",
    "prettier": "^3.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.138.g43e09c161101",
    "typescript": "^6.0.3",
    "nitro-core": "1.0.0-alpha.nightly.138.g43e09c161101"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.138.g43e09c161101",
    "nitro-core": "1.0.0-alpha.nightly.138.g43e09c161101"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    },
    "nitro-core": {
      "optional": true
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": false,
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": "bun typecheck",
      "after:bump": "bun run build"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs",
    "#react-native-mmkv": {
      "types": "./lib/MMKV.native.d.ts",
      "react-native-mmkv-mock": "./lib/MMKV.mock.js",
      "browser": "./lib/MMKV.web.js",
      "react-native": "./lib/MMKV.native.js",
      "default": "./lib/MMKV.web.js"
    }
  },
  "swiftpmConfig": {
    "name": "NitroMmkv",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  }
}
